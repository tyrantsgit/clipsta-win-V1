{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipsta",
  "version": "2.3.1",
  "identifier": "gg.clipsta.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clipsta v2.3.1",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$VIDEO/**", "$DOWNLOAD/**", "$APPDATA/**", "$TEMP/**"]
      },
      "csp": "default-src 'self' 'unsafe-inline' asset: http://asset.localhost; connect-src 'self' https://clipsta-api.godson594.workers.dev https://*.cloudflarestream.com https://*.videodelivery.net; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' blob: data: asset: http://asset.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/ffmpeg.exe"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null
      }
    }
  },
  "plugins": {}
}
